# Supabase - Project Settings > API / Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://mosquetav1.vercel.app

# Solo para scripts locales y procesos de servidor. Nunca usar NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Compatibilidad opcional con proyectos que todavía usan claves heredadas.
# SUPABASE_SERVICE_ROLE_KEY=

# Mantener "local" hasta ejecutar la migración y el importador.
# Cambiar a "supabase" para leer el catálogo desde la base de datos.
CATALOG_DATA_SOURCE=local

# Stripe Checkout. Las claves secretas nunca deben usar NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reservada para una posible integración embebida; Checkout alojado no la requiere.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
